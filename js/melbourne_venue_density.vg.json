{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Live Music Venue Concentration",
  "width": 430,
  "height": 360,

  "projection": {
    "type": "mercator",
    "center": [144.94413, -37.81306],
    "scale": 190000,
    "translate": [215, 180]
  },

  "layer": [
    {
      "data": {
        "url": "data/municipal-boundary.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2F2F2",
        "stroke": "#52636B",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/melbourne_venue_grid.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },

      "encoding": {
        "color": {
          "field": "properties.venue_count",
          "type": "quantitative",
          "title": ["Venues per", "grid cell"],
          "scale": {
            "domain": [0, 27],
            "range": [
              "#E5EDE8",
              "#78B4A5",
              "#276761"
            ]
          },
          "legend": {
            "values": [0, 10, 20, 27]
          }
        },

        "tooltip": [
          {
            "field": "properties.venue_count",
            "type": "quantitative",
            "title": "Number of Venues"
          }
        ]
      }
    }
  ]
}
